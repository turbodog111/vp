  "lines": [
    {
      "t": 10.49,
      "end": 11.56,
      "text": "Doki Doki!",
      "girl": "transitionary"
    },
    {
      "t": 11.56,
      "end": 12.45,
      "text": "Hey hey!",
      "girl": "sayori"
    },
    {
      "t": 12.45,
      "end": 16.44,
      "text": "My heart's beating when I'm hanging out with you!",
      "girl": "sayori"
    },
    {
      "t": 16.44,
      "end": 18.25,
      "text": "Why does my heart ache,",
      "girl": "sayori"
    },
    {
      "t": 18.25,
      "end": 20.7,
      "text": "When I hear you feel the same way too?",
      "girl": "sayori"
    },
    {
      "t": 20.7,
      "end": 22.68,
      "text": "(Eheheh)",
      "girl": "sayori"
    },
    {
      "t": 22.68,
      "end": 24.34,
      "text": "Just like a sundae,",
      "girl": "natsuki"
    },
    {
      "t": 24.34,
      "end": 27.99,
      "text": "It's sweet every time I teach you something new!",
      "girl": "natsuki"
    },
    {
      "t": 27.99,
      "end": 28.94,
      "text": "Is this by chance,",
      "girl": "natsuki"
    },
    {
      "t": 28.94,
      "end": 30.08,
      "text": "Or fate?",
      "girl": "natsuki"
    },
    {
      "t": 30.08,
      "end": 32.31,
      "text": "Whenever it's just me and you?",
      "girl": "natsuki"
    },
    {
      "t": 32.31,
      "end": 34.56,
      "text": "(E-Eh! Don't get the wrong idea!)",
      "girl": "natsuki"
    },
    {
      "t": 34.56,
      "end": 39.76,
      "text": "When we touch, it'll never be enough",
      "girl": "yuri"
    },
    {
      "t": 39.76,
      "end": 46.06,
      "text": "Is it way too much if you had to choose just one of us?",
      "girl": "sayori"
    },
    {
      "t": 46.06,
      "end": 48.32,
      "text": "Tell me, tell me, please!",
      "girl": "natsuki"
    },
    {
      "t": 48.32,
      "end": 49.65,
      "text": "Is this what I think,",
      "girl": "natsuki"
    },
    {
      "t": 49.65,
      "end": 51.34,
      "text": "Or is it just me?",
      "girl": "natsuki"
    },
    {
      "t": 51.34,
      "end": 53.93,
      "text": "Don't wake me up from this sweet little dream!",
      "girl": "natsuki"
    },
    {
      "t": 53.93,
      "end": 56.15,
      "text": "Where we'll be together forever",
      "girl": "natsuki"
    },
    {
      "t": 56.15,
      "end": 58.0,
      "text": "We're never gonna be apart!",
      "girl": "natsuki"
    },
    {
      "t": 58.0,
      "end": 59.9,
      "text": "Will it be okay",
      "girl": "sayori"
    },
    {
      "t": 59.9,
      "end": 62.61,
      "text": "If I express my love for you this way?",
      "girl": "sayori"
    },
    {
      "t": 62.61,
      "end": 65.72,
      "text": "No matter what you do or what you say,",
      "girl": "sayori"
    },
    {
      "t": 65.72,
      "end": 67.63,
      "text": "We'll be together forever",
      "girl": "sayori"
    },
    {
      "t": 67.63,
      "end": 73.1,
      "text": "We're never gonna be apart!",
      "girl": "sayori"
    },
    {
      "t": 73.1,
