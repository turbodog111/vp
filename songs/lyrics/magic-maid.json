    { "start": 5.75, "end": 8.4, "jp": ["だから旅に出る", "遠く旅に出る"], "romaji": ["dakara tabi ni deru", "tooku tabi ni deru"], "en": ["So I set out", "on a journey far away"] },
    { "start": 8.5, "end": 11.25, "jp": ["オマジナイの衣装", "ひとつ抱いて"], "romaji": ["omajinai no ishou", "hitotsu daite"], "en": ["Holding one costume", "for a little charm"] },
