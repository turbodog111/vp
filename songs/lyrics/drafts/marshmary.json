      "ja": "",
      "romaji": "Hotsureteku yume no naka",
      "en": "Inside an unraveling dream",
      "zh": "",
      "pinyin": ""
    },
    {
      "id": "line-2",
      "start": null,
      "end": null,
      "words": {},
      "ja": "",
      "romaji": "Donna suiheisen o mayotteta?",
      "en": "Along what horizon was I wandering?",
      "zh": "",
      "pinyin": ""
    },
    {
      "id": "line-3",
      "start": null,
      "end": null,
      "words": {},
      "ja": "",
      "romaji": "Me no mae ga boyaketeku",
      "en": "Everything before my eyes grows blurry",
      "zh": "",
      "pinyin": ""
    },
    {
      "id": "line-4",
      "start": null,
      "end": null,
      "words": {},
      "ja": "",
      "romaji": "Ima suubyou mae wa doko ni aru?",
      "en": "Where are those few seconds ago now?",
      "zh": "",
      "pinyin": ""
    },
    {
      "id": "line-5",
      "start": null,
      "end": null,
      "words": {},
      "ja": "",
      "romaji": "Uzu no naka kodou no oto",
      "en": "Inside the swirl, the sound of my heartbeat",
      "zh": "",
      "pinyin": ""
    },
    {
      "id": "line-6",
      "start": null,
      "end": null,
      "words": {},
      "ja": "",
      "romaji": "Sura moroku ni kikoenai aa wakaranain da",
