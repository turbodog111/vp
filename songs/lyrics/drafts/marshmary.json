      "pinyin": ""
    },
    {
      "id": "line-7",
      "start": null,
      "end": null,
      "words": {},
      "ja": "",
      "romaji": "Tameiki o hitotsu haita",
      "en": "I let out a single sigh",
      "zh": "",
      "pinyin": ""
    },
    {
      "id": "line-8",
      "start": null,
      "end": null,
      "words": {},
      "ja": "",
      "romaji": "Me wa sameta you de",
      "en": "As though I had woken up",
      "zh": "",
      "pinyin": ""
    },
    {
      "id": "line-9",
      "start": null,
      "end": null,
      "words": {},
      "ja": "",
      "romaji": "Ikanaide boku kara",
      "en": "Don't leave me",
      "zh": "",
      "pinyin": ""
    },
    {
